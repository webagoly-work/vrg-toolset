  "backup": {
    "title": "V R G   ·   B A C K U P",
    "subtitle": "kód + telepítők, könnyű másolat",
    "note": "A git repók a Backup\\code csupasz (bare) repóiba mennek, a munkamappák a Backup\\code\\work-be. Ami felülíródna vagy eltűnne, előbb a Backup\\archive\\sync-be kerül: semmi nem vész el.",
    "items": [
      { "key": "1", "name": "Szinkron most", "hint": "git + munkamappák", "action": "backup-sync", "accent": true },
      { "key": "2", "name": "Épség-ellenőrzés", "hint": "git fsck + SHA-256", "action": "backup-integrity" },
      { "key": "3", "name": "Utolsó szinkron jelentése", "action": "backup-report" },
      { "key": "4", "name": "Visszaállítás", "hint": "egy fájl vagy mappa", "action": "backup-restore" },
      { "key": "5", "name": "Telepítő-ellenőrzés", "hint": "{vrg}\\Backup\\installers", "action": "backup-installers" },
      { "key": "O", "name": "Backup mappa", "folder": "{vrg}\\Backup" }
    ],
    "bottom": [ { "key": "Q", "name": "Kilépés", "action": "quit" } ],
    "from": "{full}",
    "dest": "{vrg}\\Backup\\code\\work",
    "archive": "{vrg}\\Backup\\archive",
    "logs": "{vrg}\\Backup\\logs",
    "installers": "{vrg}\\Backup\\installers",
    "folders": ["BRIDGE", "BRIDGEcomp", "ESP_lab", "jobs", "notes", "Varler_Workflow_Kit", "VRG_Visual_Base", "_handoff"],
    "repos": [
      { "name": "Planner", "path": "{repo}", "bare": "{vrg}\\Backup\\code\\Planner_VRG_U100.git" },
      { "name": "heatmapper", "path": "{full}\\wifi-heatmapper", "bare": "{vrg}\\Backup\\code\\wifi-heatmapper.git" }
    ],
    "excludeDirs": ["node_modules", "__pycache__", ".pio", ".cache", ".venv", ".git"],
    "excludeFiles": ["~$*", "*.tmp", "Thumbs.db", "desktop.ini"],
    "installerRules": [
      { "dir": "tools\\arduino-cli", "match": ["arduino-cli_*.zip"] },
      { "dir": "tools\\chrome", "match": ["chrome-win64.zip"] },
      { "dir": "tools\\chrome-headless-shell", "match": ["chrome-headless-shell-win64.zip"] },
      { "dir": "tools\\chromedriver", "match": ["chromedriver-win64.zip"] },
      { "dir": "tools\\dotnet", "match": ["dotnet-sdk-*.zip", "dotnet-sdk-*.exe"] },
      { "dir": "tools\\electron", "match": ["electron-v*-win32-x64.zip"], "note": "CodeCity\\tools\\fetch-electron.js le tudja tölteni" },
      { "dir": "tools\\git", "match": ["PortableGit-*.7z*", "Git-*-64-bit.exe"] },
      { "dir": "tools\\js-libs", "match": ["DOMPurify-*.zip"], "note": "és a többi *-master.zip a zipped mappában" },
      { "dir": "tools\\node", "match": ["node-v*-win-x64.zip"] },
      { "dir": "tools\\terminal", "match": ["Microsoft.WindowsTerminal_*_x64.zip"] },
      { "dir": "tools\\vscode", "match": ["VSCode-win32-x64-*.zip"] },
      { "dir": "programs\\7zip", "match": ["7z*-x64.exe", "7z*.exe"] },
      { "dir": "programs\\CrystalDiskInfo", "match": ["CrystalDiskInfo*"] },
      { "dir": "programs\\HWiNFO", "match": ["hwi_*.zip", "hwi_*.exe"] },
      { "dir": "programs\\keytweak", "match": ["keytweak-*.exe"] },
      { "dir": "programs\\opera-gx", "match": ["Opera_GX_*.exe", "OperaGXSetup*.exe"] },
      { "dir": "programs\\VLC", "match": ["vlc-*-win64.exe"] },
      { "dir": "programs\\WizTree", "match": ["wiztree_*.zip", "wiztree_*.exe"] },
      { "dir": "programs\\zen-browser", "match": ["zen*installer*.exe", "zen*.zip"] }
    ]
  },

