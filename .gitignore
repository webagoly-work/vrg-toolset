# --- Never upload: logins, keys, browser profiles ---
Planner/home/
Planner/data/
.credentials.json
*.key
*.pem
.env*

# --- Portable programs (5 GB, not our code) ---
Planner/apps/

# --- Vendored third-party components (fetched, not authored) ---
# Rebuild with: node tools/fetch-vendor.js --all
# The reproducible part is vendor-manifest.json + Vendor/.lock.json
Vendor/
!Vendor/.lock.json

# --- Client documents stay on this PC ---
*.pdf

# --- Generated / temporary ---
node_modules/
.npm-cache/
*.log
*-log.txt
SNAPSHOT.txt
*.backup-*.html

# --- Inventory pipeline intermediates (regenerable) ---
Inventory/.cache/

# --- Generated price checks (dated snapshots, not source) ---
Inventory/price-check-*.json

# --- BRIDGE: the PDFs here are source material, not client documents ---
# Four *_buildup_BRIDGE.pdf files are the only surviving form of two lost
# documents, and the CLA blueprints are irreplaceable. Override the *.pdf rule.
!BRIDGE/**/*.pdf

# --- BRIDGE: CLA is a client property — its documents stay on this PC ---
# Blueprints, the vplan and the room schedule carry an address and a
# room-by-room survey. The design knowledge is generalised into 05_standards
# and BRIDGE-OUTLINE-001 §4, which is de-identified.
BRIDGE/07_P33/
BRIDGE/07_CLA/

# --- CoreRef: harvested upstream data is regenerable, not source ---
# `node CoreRef/tools/harvest.js` rebuilds both from pinned release tags.
# The manifest, the harvester and the report ARE committed; the payload is not.
CoreRef/data/
CoreRef/db/

# --- tools/anonymise.js: the code mapping is itself the secret ---
tools/anonymise.map.json

# --- Hub/companion: per-install secret and local settings ---
Hub/companion/.token
Hub/companion/config.json

# --- CodeCity/companion.js (Kodvaros seged): per-install secret and local settings ---
CodeCity/.companion-token
CodeCity/companion.config.json

# --- Claude Code: per-machine settings (the Kodvaros hooks, KV-10) ---
.claude/settings.local.json
