  "phases": [
    {"id":"tanulmany","hu":"Tanulmányterv / koncepció","binding":false,"basis":"chamber.mmk-2017","note":"Teljesítményigény-becslés, ellátási változatok. Nincs kötelező tartalom."},
    {"id":"engedelyezesi","hu":"Építési engedélyezési terv","binding":true,"basis":["law.281-2024","chamber.mmk-2017"],"note":"Az épületvillamossági munkarész alapszolgáltatásként csak MŰSZAKI LEÍRÁS (MMK TSZ 7.); rajz külön szolgáltatásként, ha jogszabály, hatóság vagy közműszolgáltató előírja. Fel kell sorolni a további szükséges eljárásokat (pl. 382/2007 szerinti villamosenergia-ipari engedély)."},
    {"id":"csatlakozasi","hu":"Csatlakozási / mérőhelyi dokumentáció","binding":true,"basis":["law.40-2017","std.447","operator.mee-tervkot"],"note":"A méretlen hálózatról és a mérőhelyről MMK-jogosult tervező terve. Előzetes egyeztetés az elosztóval ≥ 15 nappal a munkakezdés előtt, kivéve egyszerűsített ügykezelés (típusmegoldás Sz1/Sz2/K4/K5 + rendszerengedélyes készre szerelt mérőhely + max. 4 felhasználási hely és 1 közösségi mérés). A terv elkészítése ekkor is kötelező, és a bekapcsoláskor a helyszínen bemutatandó."},
    {"id":"kiviteli","hu":"Kivitelezési (kiviteli) terv","binding":true,"basis":["law.191-2009","chamber.mmk-2017"],"note":"MMK TSZ 12. fejezet. Nem térhet el az engedélyezett tervtől (191/2009 22. § (6)); eltérés esetén a műszaki leírásban rögzíteni."},
    {"id":"gyartmany","hu":"Gyártmányterv / műhelyterv","binding":false,"basis":"std.61439","note":"Elosztó gyártó (sorkapocsterv, huzalozás, szerelési rajz). A kiviteli terv kifejezetten nem tartalmazza (MMK 12.3.2 h)."},
    {"id":"megvalosulasi","hu":"Megvalósulási terv (as-built)","binding":true,"basis":"law.191-2009","note":"A ténylegesen megépült állapot; a kiviteli terv módosításaival átvezetve. Index 'M'."},
    {"id":"felulvizsgalat","hu":"Felülvizsgálati dokumentáció","binding":true,"basis":["std.60364","law.otsz"],"note":"Első (létesítési) ellenőrzés MSZ HD 60364-6, villámvédelmi, tűzvédelmi szabványossági; jegyzőkönyv + mérési eredmények + minősítés."}
  ],

  "projectClasses": [
    {"id":"panel","hu":"Kis elosztó / egy tábla","examples":["lakáselosztó cseréje","egy áramkör bővítése","gépészeti tábla"],"traits":["1 elosztó","≤ 24 modul","nincs mérőhely-változás"],"designDuty":"Terv akkor kell, ha a mérőhelyet, méretlen részt vagy teljesítményt érinti; egyébként kivitelezői dokumentáció + felülvizsgálat."},
    {"id":"haz","hu":"Családi ház","examples":["új családi ház 1×32 A / 3×25 A","felújítás","PV + hőszivattyú + EV"],"traits":["1 felhasználási hely","CSF/MH + 1–2 elosztó","típusmegoldás lehetséges"],"designDuty":"Csatlakozási terv kötelező (egyszerűsített ügykezelésnél is elkészítendő); kiviteli terv megrendelői igény / kivitelezői szerződés szerint, de a VRG alapcsomag tartalmazza."},
    {"id":"tarsas-kicsi","hu":"Kis társasház (pl. budai 4 lakásos)","examples":["4 lakás + közösségi mérés","villa több lakással"],"traits":["≤ 4 felhasználási hely + 1 közösségi → még egyszerűsített","csoportos mérőhely","lépcsőházi világítás","kaputelefon rendszer"],"designDuty":"Csatlakozási terv kötelező; 4 felhasználási hely + 1 közösségi felett az elosztóval előzetesen egyeztetett terv kell. Csoportos, nem készre szerelt mérőhely már 2 mérőnél is egyeztetett tervet kíván."},
    {"id":"tarsas-nagy","hu":"Nagy társasház (pl. újpesti 10 emeletes)","examples":["10 emelet × 4–8 lakás","felvonó, hő- és füstelvezetés","mérőszekrény-korszerűsítés"],"traits":["felszálló fővezeték (strang)","szintelosztók / szintenkénti mérőhelyek","biztonsági világítás","tűzvédelmi főkapcsoló","villámvédelem LPS","gyengeáramú gerinc"],"designDuty":"Minden csatlakozási dokumentáció egyeztetett; engedélyezési terv műszaki leírás + kiviteli terv teljes; OTSZ szerinti tűzvédelmi munkarész."},
    {"id":"ipar","hu":"Ipartelep","examples":["saját KÖF/KIF trafó","csarnokok, több alelosztó kaszkádban","gépsorok, PLC, Ex zónák"],"traits":["TN-S saját trafóról","szelektivitás több elosztóponton át","áramváltós mérés","kompenzáció","kábeltálca-rendszer","tartalék / szünetmentes ellátás"],"designDuty":"Teljes kiviteli terv + KÖF (382/2007) + gyártmánytervek + áramút-rajzok + kábellista; villámvédelmi kockázatkezelés; Ex dokumentáció."}
  ],

