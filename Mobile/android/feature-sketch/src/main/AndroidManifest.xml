<?xml version="1.0" encoding="utf-8"?>
<!-- VRG Sketcher (WP M24-M31). The camera goes through the phone's own camera app (CAMERA is declared by QR párosítás /
     Átadás, and Android then requires it granted for that too). Helyszín's "Itt vagyok" asks for the location once.
     Hálózat (feature-net) declares the location permissions only up to Android 12 for its WiFi scan; the Sketcher needs
     them on every version, so the cap is removed from the merged manifest. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" tools:remove="android:maxSdkVersion" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" tools:remove="android:maxSdkVersion" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- F5 (WP M50): the sound note when there is no speech recogniser; asked only when ⏺ is tapped -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Android 11+: lets SpeechRecognizer.isRecognitionAvailable see the recogniser, so the fallback shows only without one -->
    <queries>
        <intent><action android:name="android.speech.RecognitionService" /></intent>
    </queries>
    <!-- skcam K6 (WP M64): the Google AR csomag. "optional": the app installs and runs on every phone; Google Play
         Services for AR is asked for only when the user switches the pack on and opens the AR meter. -->
    <uses-feature android:name="android.hardware.camera.ar" android:required="false" />
    <application>
        <meta-data android:name="com.google.ar.core" android:value="optional" />
    </application>
</manifest>
