<?xml version="1.0" encoding="utf-8"?>
<!-- Hálózat's part of the app manifest (WP M7). docs/mobile/research/M7-network.md says why each is here. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The phone relay's server socket, and reading the links' state. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- LocalOnlyHotspot; CHANGE_NETWORK_STATE is also what Android 14 accepts for a connectedDevice service. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <!-- LocalOnlyHotspot asks for these: Android 13+ the first, Android 9-12 precise location. Asked in context only. -->
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES" android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" android:maxSdkVersion="32" />
    <!-- The relay and the usage watch keep running with the screen off; the threshold warning is a notification. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application>
        <service
            android:name=".NetService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />
    </application>
</manifest>
