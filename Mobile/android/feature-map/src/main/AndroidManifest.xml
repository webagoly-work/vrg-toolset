<?xml version="1.0" encoding="utf-8"?>
<!-- VRG Térkép (WP M43): the network (GitHub, the npm registry, the public map files, the relay) and the location for the
     map's own position dot (asked on the first tap of the position button; the position never leaves the page). As in the
     Sketcher, the Android 12 cap that Hálózat puts on the location permissions is removed from the merged manifest. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" tools:remove="android:maxSdkVersion" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" tools:remove="android:maxSdkVersion" />
    <uses-permission android:name="android.permission.INTERNET" />
</manifest>
