<?xml version="1.0" encoding="utf-8"?>
<!-- VRG Időjárás (WP M44): the network for the three weather sources, and the location for the "Itt" button only (asked on
     its first tap; the position is rounded to two decimals and goes nowhere but the forecast queries, D-144). As in the
     Sketcher and the Térkép, the Android 12 cap that Hálózat puts on the location permissions is removed. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" tools:remove="android:maxSdkVersion" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" tools:remove="android:maxSdkVersion" />
    <uses-permission android:name="android.permission.INTERNET" />
</manifest>
