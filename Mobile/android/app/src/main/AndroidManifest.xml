<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Location on every Android version: the Óra's first watch search, Térkép, Időjárás and Vázlat need it on 13+ too.
         feature-net and feature-pager cap it at 32, and a capped permission is refused without a dialog on 13+
         (2026-11-23: "Helymeghatározás engedélyezése" did nothing). The app manifest decides the merge. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" tools:remove="android:maxSdkVersion" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" tools:remove="android:maxSdkVersion" />

    <application
        android:name=".MobileApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security"
        android:supportsRtl="false"
        android:theme="@style/Theme.VrgMobile"
        tools:targetApi="35">

        <!-- The commit this APK was built from, shown in Beállítások -> Névjegy (set in build.gradle.kts). -->
        <meta-data android:name="vrg.gitSha" android:value="${gitSha}" />

        <!-- The one Activity. Every link is routed to a feature by hu.vrg.mobile.core.Links. -->
        <activity
            android:name=".ShellActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:windowSoftInputMode="adjustResize">
            <!-- The launcher entry is not here: it is one activity-alias per palette below (the icon follows the
                 palette, app/LauncherIcon.kt). -->
            <!-- vrg://<feature>[/path][?query], e.g. vrg://airdeck, vrg://pair?ws=... -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="vrg" />
            </intent-filter>
            <!-- Share text from any app -> Gyorsjegyzet (M6) -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <!-- Légegér's original link: vrgdeck://connect?ws=ws://192.168.1.24:47291 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="vrgdeck" android:host="connect" />
            </intent-filter>
            <!-- The Planner's existing phone QR (http://<pc>:47291/phone-sender.html) offers this app too. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" android:host="*" android:port="47291" android:path="/phone-sender.html" />
            </intent-filter>
        </activity>

        <!-- The home-screen icon, one per palette: exactly one is enabled at a time. Generated. -->
        <!-- launcher-aliases:begin (Mobile/catalogue/icon-gen.js) -->
        <activity-alias
            android:name=".Launcher_melyviz"
            android:targetActivity=".ShellActivity"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_melyviz"
            android:roundIcon="@mipmap/ic_launcher_melyviz">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
