<?xml version="1.0" encoding="UTF-8"?>
<drawing version="4.8">
  <settings>
    <gridSize>2.5</gridSize>
    <unit>mm</unit>
  </settings>

  <!-- =========================================================
       Raspberry Pi 5 – PCB Outline & Component Footprints
       Dimensions derived from official mechanical drawing.
       Origin (0,0) = bottom-left corner of PCB.
       Board size: 85 mm (W) x 56 mm (H)
       ========================================================= -->

  <lines>

    <!-- ── PCB Outline (85 × 56 mm rectangle, rounded corners approximated) ── -->
    <line x1="3"  y1="0"  x2="82" y2="0"  width="0.5" color="#000000"/>  <!-- bottom edge -->
    <line x1="85" y1="3"  x2="85" y2="53" width="0.5" color="#000000"/>  <!-- right edge  -->
    <line x1="82" y1="56" x2="3"  y2="56" width="0.5" color="#000000"/>  <!-- top edge    -->
    <line x1="0"  y1="53" x2="0"  y2="3"  width="0.5" color="#000000"/>  <!-- left edge   -->

    <!-- Rounded corners (3-mm radius, approximated with two 45° line segments each) -->
    <!-- Bottom-left -->
    <line x1="0"  y1="3"  x2="1"  y2="1"  width="0.5" color="#000000"/>
    <line x1="1"  y1="1"  x2="3"  y2="0"  width="0.5" color="#000000"/>
    <!-- Bottom-right -->
    <line x1="82" y1="0"  x2="84" y2="1"  width="0.5" color="#000000"/>
    <line x1="84" y1="1"  x2="85" y2="3"  width="0.5" color="#000000"/>
    <!-- Top-right -->
    <line x1="85" y1="53" x2="84" y2="55" width="0.5" color="#000000"/>
    <line x1="84" y1="55" x2="82" y2="56" width="0.5" color="#000000"/>
    <!-- Top-left -->
    <line x1="3"  y1="56" x2="1"  y2="55" width="0.5" color="#000000"/>
    <line x1="1"  y1="55" x2="0"  y2="53" width="0.5" color="#000000"/>

    <!-- ── 40-pin GPIO Header (top edge, 58 mm long, centred at x≈3.5..61.5, y=56) ── -->
    <!-- Header body outline -->
    <line x1="3.5"  y1="51" x2="61.5" y2="51" width="0.3" color="#333333"/>
    <line x1="61.5" y1="51" x2="61.5" y2="56" width="0.3" color="#333333"/>
    <line x1="61.5" y1="56" x2="3.5"  y2="56" width="0.3" color="#333333"/>
    <line x1="3.5"  y1="56" x2="3.5"  y2="51" width="0.3" color="#333333"/>

    <!-- ── USB-A 3.0 (top-right, 2-stack) – x=73..85, y=39..56 ── -->
    <line x1="73" y1="39" x2="85" y2="39" width="0.3" color="#333333"/>
    <line x1="85" y1="39" x2="85" y2="56" width="0.3" color="#333333"/>
    <line x1="85" y1="56" x2="73" y2="56" width="0.3" color="#333333"/>
    <line x1="73" y1="56" x2="73" y2="39" width="0.3" color="#333333"/>
    <!-- USB stack divider -->
    <line x1="73" y1="47.5" x2="85" y2="47.5" width="0.2" color="#555555"/>

    <!-- ── USB-A 2.0 (right side, x=73..85, y=27..39) ── -->
    <line x1="73" y1="27" x2="85" y2="27" width="0.3" color="#333333"/>
    <line x1="85" y1="27" x2="85" y2="39" width="0.3" color="#333333"/>
    <line x1="73" y1="39" x2="73" y2="27" width="0.3" color="#333333"/>

    <!-- ── Ethernet (RJ-45, bottom-right, x=73..85, y=0..18) ── -->
    <line x1="73" y1="0"  x2="85" y2="0"  width="0.3" color="#333333"/>
    <line x1="85" y1="0"  x2="85" y2="18" width="0.3" color="#333333"/>
    <line x1="85" y1="18" x2="73" y2="18" width="0.3" color="#333333"/>
    <line x1="73" y1="18" x2="73" y2="0"  width="0.3" color="#333333"/>

    <!-- ── USB-C Power (left side, x=0..10, y=42..49) ── -->
    <line x1="0"  y1="42" x2="10" y2="42" width="0.3" color="#333333"/>
    <line x1="10" y1="42" x2="10" y2="49" width="0.3" color="#333333"/>
    <line x1="10" y1="49" x2="0"  y2="49" width="0.3" color="#333333"/>
    <line x1="0"  y1="49" x2="0"  y2="42" width="0.3" color="#333333"/>

    <!-- ── HDMI 0 (left side, x=0..11, y=25..32) ── -->
    <line x1="0"  y1="25" x2="11" y2="25" width="0.3" color="#333333"/>
    <line x1="11" y1="25" x2="11" y2="32" width="0.3" color="#333333"/>
    <line x1="11" y1="32" x2="0"  y2="32" width="0.3" color="#333333"/>
    <line x1="0"  y1="32" x2="0"  y2="25" width="0.3" color="#333333"/>

    <!-- ── HDMI 1 (left side, x=0..11, y=14..21) ── -->
    <line x1="0"  y1="14" x2="11" y2="14" width="0.3" color="#333333"/>
    <line x1="11" y1="14" x2="11" y2="21" width="0.3" color="#333333"/>
    <line x1="11" y1="21" x2="0"  y2="21" width="0.3" color="#333333"/>
    <line x1="0"  y1="21" x2="0"  y2="14" width="0.3" color="#333333"/>

    <!-- ── microSD slot (bottom edge, x=11.2..39.2, y=0..5) ── -->
    <line x1="11" y1="0"  x2="39" y2="0"  width="0.3" color="#333333"/>
    <line x1="39" y1="0"  x2="39" y2="5"  width="0.3" color="#333333"/>
    <line x1="39" y1="5"  x2="11" y2="5"  width="0.3" color="#333333"/>
    <line x1="11" y1="5"  x2="11" y2="0"  width="0.3" color="#333333"/>

    <!-- ── CSI/DSI FPC connectors (bottom area) ── -->
    <!-- CAM/DSI 0: x≈40..52, y=3..8 -->
    <line x1="40" y1="3"  x2="52" y2="3"  width="0.3" color="#333333"/>
    <line x1="52" y1="3"  x2="52" y2="8"  width="0.3" color="#333333"/>
    <line x1="52" y1="8"  x2="40" y2="8"  width="0.3" color="#333333"/>
    <line x1="40" y1="8"  x2="40" y2="3"  width="0.3" color="#333333"/>
    <!-- CAM/DSI 1: x≈55..67, y=3..8 -->
    <line x1="55" y1="3"  x2="67" y2="3"  width="0.3" color="#333333"/>
    <line x1="67" y1="3"  x2="67" y2="8"  width="0.3" color="#333333"/>
    <line x1="67" y1="8"  x2="55" y2="8"  width="0.3" color="#333333"/>
    <line x1="55" y1="8"  x2="55" y2="3"  width="0.3" color="#333333"/>

    <!-- ── SoC (BCM2712, centre of board) – x≈22..42, y=20..38 ── -->
    <line x1="22" y1="20" x2="42" y2="20" width="0.4" color="#222222"/>
    <line x1="42" y1="20" x2="42" y2="38" width="0.4" color="#222222"/>
    <line x1="42" y1="38" x2="22" y2="38" width="0.4" color="#222222"/>
    <line x1="22" y1="38" x2="22" y2="20" width="0.4" color="#222222"/>

    <!-- ── LPDDR4X RAM (top of SoC area) – x≈22..42, y=38..48 ── -->
    <line x1="22" y1="38" x2="42" y2="38" width="0.4" color="#222222"/>
    <line x1="42" y1="38" x2="42" y2="48" width="0.4" color="#222222"/>
    <line x1="42" y1="48" x2="22" y2="48" width="0.4" color="#222222"/>
    <line x1="22" y1="48" x2="22" y2="38" width="0.4" color="#222222"/>

    <!-- ── PMIC (left of SoC) – x≈11..20, y=20..30 ── -->
    <line x1="11" y1="20" x2="20" y2="20" width="0.3" color="#333333"/>
    <line x1="20" y1="20" x2="20" y2="30" width="0.3" color="#333333"/>
    <line x1="20" y1="30" x2="11" y2="30" width="0.3" color="#333333"/>
    <line x1="11" y1="30" x2="11" y2="20" width="0.3" color="#333333"/>

    <!-- ── Wireless/BT module (centre-right) – x≈48..62, y=22..38 ── -->
    <line x1="48" y1="22" x2="62" y2="22" width="0.3" color="#333333"/>
    <line x1="62" y1="22" x2="62" y2="38" width="0.3" color="#333333"/>
    <line x1="62" y1="38" x2="48" y2="38" width="0.3" color="#333333"/>
    <line x1="48" y1="38" x2="48" y2="22" width="0.3" color="#333333"/>

    <!-- ── HAT+ EEPROM / debug header (right of GPIO, small) – x≈63..70, y=48..52 ── -->
    <line x1="63" y1="48" x2="70" y2="48" width="0.25" color="#555555"/>
    <line x1="70" y1="48" x2="70" y2="52" width="0.25" color="#555555"/>
    <line x1="70" y1="52" x2="63" y2="52" width="0.25" color="#555555"/>
    <line x1="63" y1="52" x2="63" y2="48" width="0.25" color="#555555"/>

  </lines>

  <!-- =========================================================
       Mounting holes (ø3 top / ø2.7 bottom, per drawing)
       Positions from drawing:
         TL: x=3.5,  y=50  (from top-left corner)
         TR: x=61.5, y=50
         BL: x=3.5,  y=6
         BR: x=61.5, y=6
       ========================================================= -->
  <circles>
    <!-- Top-left mounting hole (ø3) -->
    <circle cx="3.5"  cy="50" r="1.5" width="0.4" color="#000000" fill="none"/>
    <!-- Top-right mounting hole (ø3) -->
    <circle cx="61.5" cy="50" r="1.5" width="0.4" color="#000000" fill="none"/>
    <!-- Bottom-left mounting hole (ø2.7) -->
    <circle cx="25.8" cy="6"  r="1.35" width="0.4" color="#000000" fill="none"/>
    <!-- Bottom-right mounting hole (ø2.7) -->
    <circle cx="61.5" cy="6"  r="1.35" width="0.4" color="#000000" fill="none"/>

    <!-- Audio/AV jack circle indicator (left lower) -->
    <circle cx="7" cy="8" r="3" width="0.3" color="#333333" fill="none"/>
  </circles>

  <!-- =========================================================
       Text labels
       ========================================================= -->
  <texts>
    <text x="26"   y="30" size="3" color="#000000" bold="true">BCM2712</text>
    <text x="26"   y="27" size="2" color="#444444">SoC</text>
    <text x="26"   y="43" size="2.5" color="#000000">LPDDR4X RAM</text>
    <text x="12"   y="25" size="2" color="#000000">PMIC</text>
    <text x="49"   y="30" size="2" color="#000000">WiFi/BT</text>
    <text x="75"   y="49" size="2" color="#000000">USB3</text>
    <text x="75"   y="33" size="2" color="#000000">USB2</text>
    <text x="75"   y="9"  size="2" color="#000000">ETH</text>
    <text x="1"    y="46" size="1.8" color="#000000">PWR</text>
    <text x="1"    y="29" size="1.8" color="#000000">HDMI0</text>
    <text x="1"    y="17" size="1.8" color="#000000">HDMI1</text>
    <text x="19"   y="3"  size="1.8" color="#000000">microSD</text>
    <text x="41"   y="6"  size="1.8" color="#000000">CAM/DSI0</text>
    <text x="56"   y="6"  size="1.8" color="#000000">CAM/DSI1</text>
    <text x="6"    y="53.5" size="2" color="#000000">40-pin GPIO</text>
    <text x="64"   y="50.5" size="1.6" color="#000000">DBG</text>
    <text x="5"    y="11" size="1.8" color="#000000">AV</text>
    <!-- Board label -->
    <text x="28"   y="14" size="3.5" color="#000000" bold="true">Raspberry Pi 5</text>
  </texts>

</drawing>
