<?xml version="1.0" encoding="utf-8"?>
<!-- vrg-etw: nuget.org only, and packages.lock.json pins every package by content hash (restore runs in locked mode). -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
